<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LLMClient.Views.MemoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:LLMClient.ViewModels"
             xmlns:converters="clr-namespace:LLMClient.Converters"
             xmlns:helpers="clr-namespace:LLMClient.Helpers"
             x:DataType="viewmodel:MemoryPageViewModel"
             Title="{helpers:Translate MemoryAI}"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:CategoryToColorConverter x:Key="CategoryToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{helpers:Translate Back}" Order="Primary" Priority="0"
                     Command="{Binding BackToMainCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe5c4;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="{helpers:Translate Add}" Order="Primary" Priority="1"
                     Command="{Binding AddMemoryCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe145;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="{helpers:Translate Refresh}" Order="Primary" Priority="2"
                     Command="{Binding RefreshCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe5d5;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="{helpers:Translate Debug}" Order="Secondary" Priority="3"
                     Command="{Binding DebugTestCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe868;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- Header z wyszukiwaniem -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0"
                Padding="16"
                Margin="0,0,0,12">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray400}" Offset="0,2" Radius="8" Opacity="0.1" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                <!-- Icon and Title -->
                <Border Grid.Row="0" Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Primary}}"
                        Margin="0,0,12,0">
                    <Label Text="&#xe0e6;"
                           FontFamily="MaterialSymbols"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <StackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{helpers:Translate MemoryAI}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="{helpers:Translate MemoryDescription}"
                           TextColor="{StaticResource Gray500}"
                           FontSize="12" />
                </StackLayout>

                <!-- Search Input -->
                <Border Grid.Row="1" Grid.ColumnSpan="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="12,0"
                        Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="&#xe8b6;"
                               FontFamily="MaterialSymbols"
                               FontSize="20"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               x:Name="SearchEntry"
                               Placeholder="Wyszukaj w pamięci..."
                               Text="{Binding SearchTerm}"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               PlaceholderColor="{StaticResource Gray500}"
                               FontSize="14" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Filter Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <StackLayout Orientation="Horizontal" Spacing="8">
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColorConverter}, ConverterParameter=''}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="16,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByCategoryCommand}" CommandParameter="" />
                    </Border.GestureRecognizers>
                    <Label Text="{helpers:Translate All}"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold" />
                </Border>

                <CollectionView ItemsSource="{Binding Categories}"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding ., Converter={StaticResource CategoryToColorConverter}}"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    Padding="16,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FilterByCategoryCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       TextColor="White"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Empty State -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0"
                IsVisible="{Binding IsEmpty}">
            <StackLayout VerticalOptions="Center" Padding="32" Spacing="16">
                <Border WidthRequest="80"
                        HeightRequest="80"
                        StrokeShape="RoundRectangle 40"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        HorizontalOptions="Center">
                    <Label Text="&#xe0e6;"
                           FontFamily="MaterialSymbols"
                           FontSize="36"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="{helpers:Translate NoMemories}"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                <Label Text="{helpers:Translate AddFirstMemory}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}" />
                <Button Text="{helpers:Translate AddMemory}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Padding="24,0"
                        Command="{Binding AddMemoryCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbols" Glyph="&#xe145;" Color="White" Size="18" />
                    </Button.ImageSource>
                </Button>
            </StackLayout>
        </Border>

        <!-- Lista wspomnień -->
        <CollectionView Grid.Row="2"
                        x:Name="MemoriesCollectionView"
                        ItemsSource="{Binding FilteredMemories}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="Transparent"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditMemoryCommand}"
                                               CommandParameter="{Binding .}">
                                    <Border BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            WidthRequest="64">
                                        <Label Text="&#xe3c9;"
                                               FontFamily="MaterialSymbols"
                                               TextColor="White"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteMemoryCommand}"
                                               CommandParameter="{Binding .}">
                                    <Border BackgroundColor="{StaticResource Error}"
                                            StrokeThickness="0"
                                            WidthRequest="64">
                                        <Label Text="&#xe872;"
                                               FontFamily="MaterialSymbols"
                                               TextColor="White"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <SwipeView.Content>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="16"
                                    Margin="0,4">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray400}" Offset="0,1" Radius="4" Opacity="0.08" />
                                </Border.Shadow>
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{helpers:Translate Edit}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditMemoryCommand}"
                                                        CommandParameter="{Binding .}" />
                                        <MenuFlyoutItem Text="{helpers:Translate Delete}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteMemoryCommand}"
                                                        CommandParameter="{Binding .}" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>

                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                    <!-- Header: Key + Important badge -->
                                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Label Text="&#xe73c;"
                                               FontFamily="MaterialSymbols"
                                               FontSize="18"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Key}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </StackLayout>

                                    <!-- Important Star -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            IsVisible="{Binding IsImportant}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource Warning}}"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            Padding="8,4">
                                        <StackLayout Orientation="Horizontal" Spacing="4">
                                            <Label Text="&#xe838;"
                                                   FontFamily="MaterialSymbols"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource White}}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{helpers:Translate Important}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource White}}"
                                                   VerticalOptions="Center" />
                                        </StackLayout>
                                    </Border>

                                    <!-- Value -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Value}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                           FontSize="14"
                                           Margin="0,8,0,0"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3" />

                                    <!-- Footer: Category, Tags, Date -->
                                    <StackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                 Orientation="Horizontal"
                                                 Spacing="12"
                                                 Margin="0,12,0,0">

                                        <!-- Category Badge -->
                                        <Border BackgroundColor="{Binding Category, Converter={StaticResource CategoryToColorConverter}}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                Padding="8,4"
                                                IsVisible="{Binding Category, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                            <StackLayout Orientation="Horizontal" Spacing="4">
                                                <Label Text="&#xe2c7;"
                                                       FontFamily="MaterialSymbols"
                                                       FontSize="12"
                                                       TextColor="White"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Category}"
                                                       TextColor="White"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                            </StackLayout>
                                        </Border>

                                        <!-- Tags -->
                                        <StackLayout Orientation="Horizontal"
                                                     Spacing="4"
                                                     IsVisible="{Binding Tags, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                     VerticalOptions="Center">
                                            <Label Text="&#xe867;"
                                                   FontFamily="MaterialSymbols"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Gray500}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Tags}"
                                                   TextColor="{StaticResource Gray500}"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                        </StackLayout>

                                        <!-- Spacer -->
                                        <BoxView HorizontalOptions="FillAndExpand" />

                                        <!-- Date -->
                                        <StackLayout Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                                            <Label Text="&#xe8df;"
                                                   FontFamily="MaterialSymbols"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Gray500}"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding UpdatedAt, StringFormat='{0:dd.MM.yyyy}'}"
                                                   TextColor="{StaticResource Gray500}"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                        </StackLayout>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </SwipeView.Content>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
