<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LLMClient.Views.SemanticSearchPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LLMClient.ViewModels"
             xmlns:converters="clr-namespace:LLMClient.Converters"
             xmlns:helpers="clr-namespace:LLMClient.Helpers"
             x:DataType="viewmodels:SemanticSearchViewModel"
             Title="{helpers:Translate SemanticSearch}"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{helpers:Translate GoBack}" Order="Primary" Priority="0"
                     Command="{Binding GoBackCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe5c4;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">

        <!-- Search Section -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0"
                Padding="16"
                Margin="0,0,0,12">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray400}" Offset="0,2" Radius="8" Opacity="0.1" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                <!-- Search Input -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="12,0"
                        Margin="0,0,0,12">
                    <Entry Text="{Binding SearchQuery}"
                           Placeholder="{helpers:Translate EnterSemanticQuery}"
                           PlaceholderColor="{StaticResource Gray500}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           BackgroundColor="Transparent"
                           FontSize="15"/>
                </Border>

                <!-- Search Mode Selector -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" Margin="0,0,0,12" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{helpers:Translate TextMode}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetTextModeCommand}"
                            Clicked="OnTextModeClicked"
                            BackgroundColor="{Binding IsTextMode, Converter={StaticResource BoolToColorConverter}}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="36"
                            FontSize="12"/>
                    <Button Grid.Column="1"
                            Text="{helpers:Translate HybridMode}"
                            Clicked="OnHybridModeClicked"
                            BackgroundColor="{Binding IsHybridMode, Converter={StaticResource BoolToColorConverter}}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="36"
                            FontSize="12"/>
                    <Button Grid.Column="2"
                            Text="{helpers:Translate VectorMode}"
                            Clicked="OnVectorModeClicked"
                            BackgroundColor="{Binding IsVectorMode, Converter={StaticResource BoolToColorConverter}}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="36"
                            FontSize="12"/>
                </Grid>

                <!-- Search Controls -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{helpers:Translate Search}"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding CanSearch}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            FontSize="14">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialSymbols" Glyph="&#xe8b6;" Color="White" Size="18" />
                        </Button.ImageSource>
                    </Button>
                    <Label Grid.Column="1"
                           Text="{Binding SearchModeText, StringFormat='Tryb: {0}'}"
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center"
                           FontSize="12"/>
                    <Button Grid.Column="2"
                            Text="{helpers:Translate DownloadModel}"
                            Command="{Binding DownloadModelCommand}"
                            IsVisible="{Binding IsModelReady, Converter={StaticResource InverseBoolConverter}}"
                            IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="{StaticResource Warning}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            FontSize="13"/>
                    <ActivityIndicator Grid.Column="3"
                                       IsRunning="{Binding IsDownloadingModel}"
                                       IsVisible="{Binding IsDownloadingModel}"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       VerticalOptions="Center"/>
                </Grid>

                <!-- Settings -->
                <Grid Grid.Row="3" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8" ColumnSpacing="12" RowSpacing="8">
                    <Label Grid.Row="0" Grid.Column="0" Text="{helpers:Translate Similarity}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" FontSize="13"
                           IsVisible="{Binding ShowVectorSettings}"/>
                    <Slider Grid.Row="0" Grid.Column="1"
                            Value="{Binding MinSimilarity}"
                            Minimum="0.1"
                            Maximum="0.9"
                            ThumbColor="{StaticResource Primary}"
                            MinimumTrackColor="{StaticResource Primary}"
                            VerticalOptions="Center"
                            IsVisible="{Binding ShowVectorSettings}"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="{helpers:Translate Max}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" FontSize="13"/>
                    <Stepper Grid.Row="0" Grid.Column="3"
                             Value="{Binding MaxResults}"
                             Minimum="5"
                             Maximum="50"
                             Increment="5"
                             VerticalOptions="Center"/>

                    <!-- Hybrid Weight Settings -->
                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="{Binding TextWeightPercentage, StringFormat='Tekst: {0}'}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" FontSize="12"
                           IsVisible="{Binding IsHybridMode}"/>
                    <Slider Grid.Row="1" Grid.Column="1"
                            Value="{Binding VectorWeight}"
                            Minimum="0.1"
                            Maximum="0.9"
                            ThumbColor="{StaticResource Secondary}"
                            MinimumTrackColor="{StaticResource Secondary}"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsHybridMode}"/>
                    <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="{Binding VectorWeightPercentage, StringFormat='Wektor: {0}'}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" FontSize="12"
                           IsVisible="{Binding IsHybridMode}"/>
                </Grid>

                <!-- Status -->
                <Label Grid.Row="4" Grid.ColumnSpan="2"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}"/>
            </Grid>
        </Border>

        <!-- Settings Display -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="4,0,4,8">
            <Label Grid.Column="0"
                   Text="{Binding MinSimilarityPercentage, StringFormat='Próg: {0}'}"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"/>
            <Label Grid.Column="1"
                   Text="{Binding MaxResults, StringFormat='Limit: {0}'}"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="End"/>
        </Grid>

        <!-- Embedding Pipeline Section -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Margin="0,0,0,12"
                Padding="16">

            <StackLayout Spacing="8">
                <StackLayout Orientation="Horizontal" Spacing="12">
                    <Label Text="&#xe4fc;"
                           FontFamily="MaterialSymbols"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding EmbeddingStatsText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"/>
                    <Button Command="{Binding CheckEmbeddingStatsCommand}"
                            BackgroundColor="Transparent"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialSymbols"
                                           Glyph="&#xe5d5;"
                                           Color="{StaticResource Primary}"
                                           Size="20" />
                        </Button.ImageSource>
                    </Button>
                </StackLayout>

                <Label Text="{Binding EmbeddingProgress}"
                       FontSize="11"
                       TextColor="{StaticResource Gray500}"
                       IsVisible="{Binding IsGeneratingEmbeddings}"
                       HorizontalTextAlignment="Center"/>
            </StackLayout>
        </Border>

        <!-- Global spinner overlay -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="4"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}"
                           WidthRequest="48"
                           HeightRequest="48"
                           ZIndex="999"/>

        <!-- Results Section -->
        <Border Grid.Row="3"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray400}" Offset="0,2" Radius="8" Opacity="0.1" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">
                <!-- Results Header -->
                <Label Grid.Row="0"
                       Text="{helpers:Translate SearchResults}"
                       FontSize="16"
                       FontAttributes="Bold"
                       Padding="16,12,16,8"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>

                <!-- Results List -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding SearchResults}"
                                BackgroundColor="Transparent">

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center" Padding="20" Spacing="12">
                            <Border WidthRequest="64"
                                    HeightRequest="64"
                                    StrokeShape="RoundRectangle 32"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    HorizontalOptions="Center">
                                <Label Text="&#xe8b6;"
                                       FontFamily="MaterialSymbols"
                                       FontSize="28"
                                       TextColor="{StaticResource Gray500}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="{helpers:Translate NoResults}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                            <Label Text="{helpers:Translate TryChangingQuery}"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="16"
                                    Margin="12,4">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToMessageCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                    <!-- Header with similarity and conversation -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <Label Grid.Column="0"
                                               Text="{Binding ConversationTitle}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               LineBreakMode="TailTruncation"/>

                                        <Border Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Primary}}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                Padding="8,4">
                                            <Label Text="{Binding SimilarityPercentage}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Message content -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Message.Content}"
                                           FontSize="14"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           Margin="0,0,0,8"/>

                                    <!-- Message metadata -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Message.IsUser, Converter={StaticResource BoolToColorConverter}}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}"/>

                                        <Label Grid.Column="2"
                                               Text="{Binding MessageTimestamp, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}"/>
                                    </Grid>

                                    <!-- Bottom accent -->
                                    <BoxView Grid.Row="3"
                                             Color="{StaticResource Primary}"
                                             HeightRequest="2"
                                             CornerRadius="1"
                                             Opacity="0.5"
                                             Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
