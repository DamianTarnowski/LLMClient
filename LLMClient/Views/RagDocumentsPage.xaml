<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LLMClient.ViewModels"
             xmlns:models="clr-namespace:LLMClient.Models"
             x:Class="LLMClient.Views.RagDocumentsPage"
             x:DataType="viewmodels:RagViewModel"
             Title="Dokumenty RAG"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="20" RowSpacing="16">
        
            <!-- Header with gradient -->
            <Border Grid.Row="0" StrokeThickness="0" 
                    StrokeShape="RoundRectangle 20"
                    Padding="24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource Tertiary}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto">
                    <StackLayout Spacing="4">
                        <Label Text="📚 Dokumenty RAG"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Zarządzaj bazą wiedzy dla AI"
                               FontSize="14"
                               TextColor="#E0E7FF"/>
                    </StackLayout>
                    <!-- Pending badge -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding HasPendingEmbeddings}"
                            BackgroundColor="#FBBF24"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <Label Text="{Binding PendingEmbeddings, StringFormat='{0} oczekuje'}"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <Border Grid.Row="1" 
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="➕ Dodaj dokumenty"
                            Command="{Binding AddDocumentCommand}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                                <GradientStop Color="#7C3AED" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    
                    <Button Grid.Column="1"
                            Text="⚡ Generuj embeddingi"
                            Command="{Binding GenerateEmbeddingsCommand}"
                            IsEnabled="{Binding CanProcess}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource Secondary}" Offset="0.0" />
                                <GradientStop Color="#059669" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    
                    <Button Grid.Column="2"
                            Text="🔄"
                            Command="{Binding LoadDocumentsCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                            CornerRadius="12"
                            WidthRequest="48"
                            HeightRequest="48"/>
                </Grid>
            </Border>

            <!-- Documents list -->
            <Border Grid.Row="2" 
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="8"
                    MinHeightRequest="200">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            <CollectionView ItemsSource="{Binding Documents}"
                            SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <Label Text="📄" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Brak dokumentów"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"/>
                    <Label Text="Dodaj dokumenty PDF, DOCX lub TXT"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RagDocument">
                    <Frame Margin="0,4" 
                           Padding="12"
                           CornerRadius="8"
                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                            
                            <!-- File name -->
                            <Label Grid.Column="0" Grid.Row="0"
                                   Text="{Binding FileName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                            
                            <!-- Metadata -->
                            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Spacing="16">
                                <Label Text="{Binding ChunkCount, StringFormat='{0} chunków'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            </HorizontalStackLayout>
                            
                            <!-- Embedding status -->
                            <Frame Grid.Column="1" Grid.RowSpan="2"
                                   VerticalOptions="Center"
                                   Padding="8,4"
                                   CornerRadius="4"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                <Label Text="{Binding HasEmbeddings, Converter={StaticResource BoolToEmbeddingStatusConverter}}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            </Frame>
                            
                            <!-- Delete button -->
                            <Button Grid.Column="2" Grid.RowSpan="2"
                                    Text="🗑️"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RagViewModel}}, Path=DeleteDocumentCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
            </Border>

            <!-- Progress bar -->
            <ProgressBar Grid.Row="3"
                         Progress="{Binding IngestionProgress}"
                         IsVisible="{Binding IsProcessing}"
                         ProgressColor="{StaticResource Primary}"/>

            <!-- Status bar -->
            <Border Grid.Row="4"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="16,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center"/>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="20"
                                       WidthRequest="20"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
