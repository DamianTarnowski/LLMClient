<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LLMClient.Views.MlcModelSelectorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LLMClient.ViewModels"
             xmlns:models="clr-namespace:LLMClient.Models"
             xmlns:converters="clr-namespace:LLMClient.Converters"
             x:DataType="viewModels:MlcModelSelectorViewModel"
             Title="Wybierz model AI"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                Padding="16"
                StrokeThickness="0">
            <StackLayout Spacing="12">

                <!-- Current Selection -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="16"
                        IsVisible="{Binding HasSelectedModel}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout>
                            <Label Text="Active Model"
                                   TextColor="White"
                                   FontSize="12"
                                   Opacity="0.8" />
                            <Label Text="{Binding SelectedModelName}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                        </StackLayout>
                        <Label Grid.Column="1"
                               Text="&#xf00c;"
                               FontFamily="MaterialSymbols"
                               FontSize="24"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Download Progress -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="16"
                        IsVisible="{Binding IsDownloading}">
                    <StackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DownloadStatus}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Button Grid.Column="1"
                                    Text="Cancel"
                                    BackgroundColor="{StaticResource Error}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,4"
                                    HeightRequest="32"
                                    CornerRadius="8"
                                    Command="{Binding CancelDownloadCommand}" />
                        </Grid>
                        <ProgressBar Progress="{Binding DownloadProgress}"
                                     ProgressColor="{StaticResource Primary}"
                                     HeightRequest="8" />
                        <Label Text="{Binding CurrentDownloadFile}"
                               FontSize="11"
                               TextColor="{StaticResource Gray500}" />
                    </StackLayout>
                </Border>

                <!-- Storage Info -->
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Label Text="{Binding TotalDownloadedSizeText}"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                    <Switch IsToggled="{Binding ShowAllModels}"
                            VerticalOptions="Center" />
                    <Label Text="Show all models"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </StackLayout>

                <!-- Custom Model Path -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="16"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasSelectedModel}">
                    <StackLayout Spacing="8">
                        <Label Text="Własna ścieżka do modelu (opcjonalnie)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <Label Text="Możesz wskazać folder z już pobranym modelem (np. /storage/emulated/0/Download/LLMClient/Models/mlc lub jego podfolder z nazwą modelu)."
                               FontSize="11"
                               TextColor="{StaticResource Gray500}" />

                        <Entry Text="{Binding CustomModelPath}"
                               Placeholder="/storage/emulated/0/Download/LLMClient/Models/mlc"
                               FontSize="12"
                               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}" />

                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Button Text="Zapisz"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="16,8"
                                    CornerRadius="10"
                                    Command="{Binding SaveCustomModelPathCommand}" />
                            <Button Text="Wyczyść"
                                    BackgroundColor="{StaticResource Gray500}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="16,8"
                                    CornerRadius="10"
                                    Command="{Binding ClearCustomModelPathCommand}" />
                        </StackLayout>

                        <Label Text="{Binding CustomModelPathStatus}"
                               FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                </Border>
            </StackLayout>
        </Border>

        <!-- Models List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Models}"
                        SelectionMode="None"
                        Margin="16,8">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ModelItemViewModel">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Gray400}" Offset="0,2" Radius="8" Opacity="0.1" />
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                            <!-- Model Name & Badge -->
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="{Binding Model.DisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Primary}}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        Padding="6,2"
                                        IsVisible="{Binding Model.IsRecommended}">
                                    <Label Text="Recommended"
                                           FontSize="10"
                                           TextColor="White" />
                                </Border>
                            </StackLayout>

                            <!-- Status Badge -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding StatusColor}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    Padding="8,4"
                                    VerticalOptions="Start">
                                <Label Text="{Binding StatusText}"
                                       FontSize="10"
                                       TextColor="White" />
                            </Border>

                            <!-- Description -->
                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding Model.Description}"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="0,4,0,0" />

                            <!-- Stats Row -->
                            <StackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                         Orientation="Horizontal"
                                         Spacing="16"
                                         Margin="0,8,0,0">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="&#xe322;"
                                           FontFamily="MaterialSymbols"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding Model.ParameterCount}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </StackLayout>
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="&#xe161;"
                                           FontFamily="MaterialSymbols"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding SizeText}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </StackLayout>
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="&#xe322;"
                                           FontFamily="MaterialSymbols"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding RamText}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </StackLayout>
                            </StackLayout>

                            <!-- Languages -->
                            <Label Grid.Row="3" Grid.ColumnSpan="2"
                                   Text="{Binding Model.LanguagesDisplay, StringFormat='Languages: {0}'}"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray400}"
                                   Margin="0,4,0,0" />

                            <!-- Action Buttons -->
                            <StackLayout Grid.Row="3" Grid.Column="1"
                                         Orientation="Horizontal"
                                         Spacing="8"
                                         VerticalOptions="End"
                                         HorizontalOptions="End">

                                <!-- Download Button -->
                                <Button Text="Download"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        FontSize="12"
                                        Padding="16,8"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MlcModelSelectorViewModel}}, Path=DownloadModelCommand}"
                                        CommandParameter="{Binding Model}"
                                        IsVisible="{Binding IsDownloaded, Converter={StaticResource InverseBoolConverter}}" />

                                <!-- Select Button (for downloaded models) -->
                                <Button Text="Select"
                                        BackgroundColor="{StaticResource Success}"
                                        TextColor="White"
                                        FontSize="12"
                                        Padding="16,8"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MlcModelSelectorViewModel}}, Path=SelectModelCommand}"
                                        CommandParameter="{Binding Model}"
                                        IsVisible="{Binding IsDownloaded}" />

                                <!-- Delete Button -->
                                <Button Text="&#xe872;"
                                        FontFamily="MaterialSymbols"
                                        BackgroundColor="{StaticResource Error}"
                                        TextColor="White"
                                        FontSize="16"
                                        Padding="8"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MlcModelSelectorViewModel}}, Path=DeleteModelCommand}"
                                        CommandParameter="{Binding Model.Id}"
                                        IsVisible="{Binding IsDownloaded}" />
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32">
                    <Label Text="No models available"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Enable 'Show all models' to see larger options"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Bottom Bar -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                Padding="16"
                StrokeThickness="0">
            <Button Text="Done"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="16"
                    CornerRadius="12"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=GoBackCommand}" />
        </Border>
    </Grid>
</ContentPage>
