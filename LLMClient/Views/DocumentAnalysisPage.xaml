<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LLMClient.ViewModels"
             xmlns:models="clr-namespace:LLMClient.Models"
             x:Class="LLMClient.Views.DocumentAnalysisPage"
             x:DataType="viewmodels:DocumentAnalysisViewModel"
             Title="Analiza dokumentu"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
        
            <!-- Header with gradient -->
            <Border StrokeThickness="0" 
                    StrokeShape="RoundRectangle 20"
                    Padding="24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource Tertiary}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                </Border.Shadow>
                <StackLayout Spacing="4">
                    <Label Text="🔍 Analiza Dokumentu"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Wyciągaj kluczowe informacje z tekstu"
                           FontSize="14"
                           TextColor="#E0E7FF"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Border>

            <!-- Input section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="12">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="📝" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Tekst do analizy"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12"
                            HeightRequest="150">
                        <Editor Text="{Binding InputText}"
                                BackgroundColor="Transparent"
                                Placeholder="Wklej tekst dokumentu, transkryptu lub rozmowy do analizy..."
                                PlaceholderColor="{StaticResource Gray500}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                FontSize="14"/>
                    </Border>
                    
                    <!-- Action buttons -->
                    <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Text="🚀 Analizuj"
                                Command="{Binding AnalyzeCommand}"
                                IsEnabled="{Binding CanAnalyze}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44"
                                FontAttributes="Bold">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                                    <GradientStop Color="#7C3AED" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        
                        <Button Grid.Column="1"
                                Text="⚡ Streaming"
                                Command="{Binding AnalyzeStreamingCommand}"
                                IsEnabled="{Binding CanAnalyze}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44"
                                FontAttributes="Bold">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource Secondary}" Offset="0.0" />
                                    <GradientStop Color="#059669" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        
                        <Button Grid.Column="2"
                                Text="📋"
                                Command="{Binding PasteFromClipboardCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                CornerRadius="12"
                                WidthRequest="44"
                                HeightRequest="44"/>
                        
                        <Button Grid.Column="3"
                                Text="🗑️"
                                Command="{Binding ClearCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                CornerRadius="12"
                                WidthRequest="44"
                                HeightRequest="44"/>
                        
                        <Button Grid.Column="4"
                                Text="❌"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsAnalyzing}"
                                CornerRadius="12"
                                WidthRequest="44"
                                HeightRequest="44">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource Error}" Offset="0.0" />
                                    <GradientStop Color="#DC2626" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                    
                    <ActivityIndicator IsRunning="{Binding IsAnalyzing}"
                                       IsVisible="{Binding IsAnalyzing}"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="24"
                                       HorizontalOptions="Center"/>
                </StackLayout>
            </Border>

            <!-- Streaming output -->
            <Border IsVisible="{Binding StreamingOutput, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="8">
                    <Label Text="⏳ Wynik (streaming)"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    <Label Text="{Binding StreamingOutput}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                </StackLayout>
            </Border>

            <!-- Summary -->
            <Border IsVisible="{Binding HasResult}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="8">
                    <Label Text="📋 Podsumowanie"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding AnalysisResult.Summary}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                </StackLayout>
            </Border>

                <!-- Key Points -->
                <Frame IsVisible="{Binding KeyPoints.Count, Converter={StaticResource ZeroToInverseBoolConverter}}"
                       Padding="12"
                       CornerRadius="8"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout>
                        <Label Text="🎯 Kluczowe punkty"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                               Margin="0,0,0,8"/>
                        <CollectionView ItemsSource="{Binding KeyPoints}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='• {0}'}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                           Margin="8,2"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Detected Intents -->
                <Frame IsVisible="{Binding Intents.Count, Converter={StaticResource ZeroToInverseBoolConverter}}"
                       Padding="12"
                       CornerRadius="8"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout>
                        <Label Text="🔍 Wykryte intencje"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                               Margin="0,0,0,8"/>
                        <CollectionView ItemsSource="{Binding Intents}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DetectedIntent">
                                    <Frame Margin="0,4" Padding="10" CornerRadius="6"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Intent}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"/>
                                                <Label Text="{Binding Evidence, StringFormat='&quot;{0}&quot;'}"
                                                       FontSize="12"
                                                       FontAttributes="Italic"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Confidence, StringFormat='{0:P0}'}"
                                                   FontSize="12"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource Primary}"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Red Flags -->
                <Frame IsVisible="{Binding RedFlags.Count, Converter={StaticResource ZeroToInverseBoolConverter}}"
                       Padding="12"
                       CornerRadius="8"
                       BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                       BorderColor="{StaticResource Danger}">
                    <VerticalStackLayout>
                        <Label Text="⚠️ Czerwone flagi"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Danger}"
                               Margin="0,0,0,8"/>
                        <CollectionView ItemsSource="{Binding RedFlags}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RedFlag">
                                    <Frame Margin="0,4" Padding="10" CornerRadius="6"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                        <VerticalStackLayout Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Severity}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Danger}"/>
                                                <Label Text="{Binding Description}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Quote, StringFormat='&quot;{0}&quot;'}"
                                                   FontSize="12"
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                   IsVisible="{Binding Quote, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                            <Label Text="{Binding Recommendation, StringFormat='💡 {0}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Primary}"
                                                   IsVisible="{Binding Recommendation, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Compliance Checklist -->
                <Frame IsVisible="{Binding ComplianceItems.Count, Converter={StaticResource ZeroToInverseBoolConverter}}"
                       Padding="12"
                       CornerRadius="8"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout>
                        <Label Text="✅ Lista kontrolna"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                               Margin="0,0,0,8"/>
                        <CollectionView ItemsSource="{Binding ComplianceItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ComplianceItem">
                                    <HorizontalStackLayout Spacing="8" Margin="0,4">
                                        <Label Text="{Binding IsMet, Converter={StaticResource BoolToCheckmarkConverter}}"
                                               FontSize="14"
                                               WidthRequest="24"/>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Requirement}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"/>
                                            <Label Text="{Binding Details}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   IsVisible="{Binding Details, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Suggested Response -->
                <Frame IsVisible="{Binding AnalysisResult.SuggestedResponse, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                       Padding="12"
                       CornerRadius="8"
                       BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#052E16}"
                       BorderColor="{StaticResource Success}">
                    <VerticalStackLayout>
                        <Label Text="💬 Sugerowana odpowiedź"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               Margin="0,0,0,8"/>
                        <Label Text="{Binding AnalysisResult.SuggestedResponse}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"/>
                    </VerticalStackLayout>
                </Frame>

            <!-- Status bar -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="16,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding AnalysisResult.Metrics.WordCount, StringFormat='{0} słów'}"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding HasResult}"
                           VerticalOptions="Center"
                           Margin="16,0"/>
                    <Label Grid.Column="2"
                           Text="{Binding AnalysisResult.Metrics.SentenceCount, StringFormat='{0} zdań'}"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding HasResult}"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>
