<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LLMClient.Views.ModelSettingsPage"
             Title="Ustawienia Modelu"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Wróć"
                     Priority="0"
                     Order="Primary"
                     Command="{Binding GoBackCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe5c4;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <Label Text="Ustawienia Modelu AI"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                   Margin="0,0,0,12"/>

            <!-- Current Model Info -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400}" Offset="0,2" Radius="8" Opacity="0.1" />
                </Border.Shadow>
                <StackLayout Spacing="8">
                    <Label Text="Aktywny Model"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"/>
                    <Label Text="{Binding CurrentModelName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    <Label Text="{Binding ModelType}"
                           FontSize="13"
                           TextColor="{StaticResource Secondary}"/>
                </StackLayout>
            </Border>

            <!-- Local Engine Selection -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="20">
                <StackLayout Spacing="12">
                    <Label Text="Silnik Lokalny"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding EngineOptions}"
                                SelectedItem="{Binding SelectedEngine}"
                                Title="Wybierz silnik"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>
                </StackLayout>
            </Border>

            <!-- System Prompt Section -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="20">
                <StackLayout Spacing="12">
                    <Label Text="Prompt Systemowy"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12"
                            HeightRequest="120">
                        <Editor Text="{Binding SystemPrompt}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                Placeholder="Wprowadź prompt systemowy..."
                                PlaceholderColor="{StaticResource Gray500}"
                                FontSize="14"/>
                    </Border>

                    <!-- Include Memory Toggle -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Switch Grid.Column="0"
                                    IsToggled="{Binding IncludeMemoryInSystemPrompt}"
                                    OnColor="{StaticResource Primary}"/>
                            <Label Grid.Column="1"
                                   Text="Dołącz pamięć użytkownika (tylko modele chmurowe)"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   FontSize="13"/>
                        </Grid>
                    </Border>
                </StackLayout>
            </Border>

            <!-- Local Model Parameters -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="20"
                    IsVisible="{Binding IsLocalModelActive}">
                <StackLayout Spacing="20">
                    <Label Text="Parametry Modelu Lokalnego"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <!-- Temperature -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Temperatura (Kreatywność)"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Temperature, StringFormat='{0:F1}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding Temperature}"
                                Minimum="0.1"
                                Maximum="1.0"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Skupiona" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Kreatywna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Max Length -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Maksymalna Długość Odpowiedzi"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding MaxLength}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding MaxLength}"
                                Minimum="128"
                                Maximum="2048"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Krótka" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Długa" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Repetition Penalty -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Kara za Powtórzenia"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding RepetitionPenalty, StringFormat='{0:F2}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding RepetitionPenalty}"
                                Minimum="1.0"
                                Maximum="1.5"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Więcej powtórzeń" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Mniej powtórzeń" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Top P -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Top P (Nucleus Sampling)"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding TopP, StringFormat='{0:F2}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding TopP}"
                                Minimum="0.1"
                                Maximum="1.0"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Konserwatywna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Różnorodna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Grid.Column="0"
                        Text="Zapisz"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontSize="15"
                        FontAttributes="Bold"/>

                <Button Grid.Column="1"
                        Text="Resetuj"
                        Command="{Binding ResetCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontSize="15"
                        FontAttributes="Bold"/>
            </Grid>

        </StackLayout>
    </ScrollView>

</ContentPage>
