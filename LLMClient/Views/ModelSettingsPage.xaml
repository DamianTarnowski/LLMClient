<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LLMClient.ViewModels"
             x:Class="LLMClient.Views.ModelSettingsPage"
             x:DataType="viewmodels:ModelSettingsViewModel"
             Title="Ustawienia Modelu"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Wróć"
                     Priority="0"
                     Order="Primary"
                     Command="{Binding GoBackCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialSymbols"
                               Glyph="&#xe5c4;"
                               Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">

            <!-- Header with gradient -->
            <Border StrokeThickness="0" 
                    StrokeShape="RoundRectangle 20"
                    Padding="24,20"
                    Margin="0,0,0,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource Tertiary}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                </Border.Shadow>
                <StackLayout Spacing="4">
                    <Label Text="⚙️ Ustawienia Modelu"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Dostosuj parametry AI"
                           FontSize="14"
                           TextColor="#E0E7FF"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Border>

            <!-- Current Model Info -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400}" Offset="0,3" Radius="10" Opacity="0.12" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Grid.Column="0" 
                            WidthRequest="52" HeightRequest="52" 
                            StrokeShape="RoundRectangle 26" 
                            StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Secondary}" Offset="0.0" />
                                <GradientStop Color="#059669" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="🤖" FontSize="24" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Aktywny Model"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                        <Label Text="{Binding CurrentModelName}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                        <Label Text="{Binding ModelType}"
                               FontSize="13"
                               TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Local Engine Selection -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="12">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="⚡" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Silnik Lokalny"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="14,4">
                        <Picker ItemsSource="{Binding EngineOptions}"
                                SelectedItem="{Binding SelectedEngine}"
                                Title="Wybierz silnik"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                TitleColor="{StaticResource Gray500}"
                                FontSize="15"/>
                    </Border>
                </StackLayout>
            </Border>

            <!-- System Prompt Section -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="12">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="📝" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Prompt Systemowy"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center"/>
                    </StackLayout>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12"
                            HeightRequest="120">
                        <Editor Text="{Binding SystemPrompt}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                Placeholder="Wprowadź prompt systemowy..."
                                PlaceholderColor="{StaticResource Gray500}"
                                FontSize="14"/>
                    </Border>

                    <!-- Include Memory Toggle -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Switch Grid.Column="0"
                                    IsToggled="{Binding IncludeMemoryInSystemPrompt}"
                                    OnColor="{StaticResource Primary}"/>
                            <Label Grid.Column="1"
                                   Text="Dołącz pamięć użytkownika (tylko modele chmurowe)"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   FontSize="13"/>
                        </Grid>
                    </Border>
                </StackLayout>
            </Border>

            <!-- Local Model Parameters -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeThickness="1"
                    Padding="20"
                    IsVisible="{Binding IsLocalModelActive}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark=#1F2937}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light={StaticResource SurfaceLight2}, Dark=#111827}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="20">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="🏛️" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Parametry Modelu"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center"/>
                    </StackLayout>

                    <!-- Temperature -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Temperatura (Kreatywność)"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Temperature, StringFormat='{0:F1}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding Temperature}"
                                Minimum="0.1"
                                Maximum="1.0"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Skupiona" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Kreatywna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Max Length -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Maksymalna Długość Odpowiedzi"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding MaxLength}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding MaxLength}"
                                Minimum="128"
                                Maximum="2048"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Krótka" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Długa" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Repetition Penalty -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Kara za Powtórzenia"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding RepetitionPenalty, StringFormat='{0:F2}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding RepetitionPenalty}"
                                Minimum="1.0"
                                Maximum="1.5"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Więcej powtórzeń" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Mniej powtórzeń" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>

                    <!-- Top P -->
                    <StackLayout Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="Top P (Nucleus Sampling)"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding TopP, StringFormat='{0:F2}'}"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Slider Value="{Binding TopP}"
                                Minimum="0.1"
                                Maximum="1.0"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        <Grid>
                            <Label Text="Konserwatywna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start"/>
                            <Label Text="Różnorodna" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End"/>
                        </Grid>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="✔️ Zapisz"
                        Command="{Binding SaveCommand}"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="54"
                        FontSize="16"
                        FontAttributes="Bold">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Secondary}" Offset="0.0" />
                            <GradientStop Color="#059669" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Secondary}" Offset="0,3" Radius="6" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <Button Grid.Column="1"
                        Text="🔄 Resetuj"
                        Command="{Binding ResetCommand}"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="54"
                        FontSize="16"
                        FontAttributes="Bold">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Error}" Offset="0.0" />
                            <GradientStop Color="#DC2626" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Error}" Offset="0,3" Radius="6" Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </Grid>

        </StackLayout>
    </ScrollView>

</ContentPage>
