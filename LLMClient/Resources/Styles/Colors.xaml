<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Color Palette - Inspired by ChatGPT/Claude -->

    <!-- Primary Brand Colors -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#818CF8</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="PrimaryLight">#E0E7FF</Color>

    <!-- Secondary/Accent -->
    <Color x:Key="Secondary">#10B981</Color>
    <Color x:Key="SecondaryDark">#34D399</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>

    <!-- Tertiary -->
    <Color x:Key="Tertiary">#8B5CF6</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>

    <!-- Base Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1E1B4B</Color>

    <!-- Light Theme Surfaces -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceLight2">#F9FAFB</Color>
    <Color x:Key="SurfaceLight3">#F3F4F6</Color>
    <Color x:Key="BackgroundLight">#F9FAFB</Color>

    <!-- Dark Theme Surfaces -->
    <Color x:Key="SurfaceDark">#1F2937</Color>
    <Color x:Key="SurfaceDark2">#111827</Color>
    <Color x:Key="SurfaceDark3">#374151</Color>
    <Color x:Key="BackgroundDark">#111827</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <!-- Gray Scale (Tailwind inspired) -->
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Chat Bubble Colors -->
    <Color x:Key="UserBubbleLight">#4F46E5</Color>
    <Color x:Key="UserBubbleDark">#5B52E8</Color>
    <Color x:Key="BotBubbleLight">#F3F4F6</Color>
    <Color x:Key="BotBubbleDark">#374151</Color>

    <!-- Input Colors -->
    <Color x:Key="InputBackgroundLight">#F3F4F6</Color>
    <Color x:Key="InputBackgroundDark">#374151</Color>
    <Color x:Key="InputBorderLight">#E5E7EB</Color>
    <Color x:Key="InputBorderDark">#4B5563</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
