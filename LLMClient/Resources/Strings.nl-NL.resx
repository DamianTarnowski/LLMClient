  </data>
  <data name="HelpLocalModelContent" xml:space="preserve">
    <value>Lokale modus draait AI direct op je apparaat - geen internet nodig, volledige privacy. Download eerst het model (ongeveer 400MB), laad het dan om te beginnen met chatten.</value>
  </data>
  <data name="HelpAPIModels" xml:space="preserve">
    <value>Cloud API-modellen</value>
  </data>
  <data name="HelpAPIModelsContent" xml:space="preserve">
