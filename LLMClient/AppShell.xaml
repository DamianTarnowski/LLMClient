<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LLMClient.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LLMClient"
    xmlns:views="clr-namespace:LLMClient.Views"
    Title="LLMClient">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Semantic Search"
        ContentTemplate="{DataTemplate views:SemanticSearchPage}"
        Route="SemanticSearchPage" />

    <ShellContent
        Title="Memory"
        ContentTemplate="{DataTemplate views:MemoryPage}"
        Route="MemoryPage" />

    <ShellContent
        Title="Model Settings"
        ContentTemplate="{DataTemplate views:ModelSettingsPage}"
        Route="ModelSettingsPage" />

    <!-- MLC Model Manager - TEMPORARILY DISABLED (see docs/MLC_LLM_ISSUES.md)
         Issues: OpenCL removed on Samsung S25, Vulkan build problems
         TODO: Re-enable when Vulkan backend is fixed
    <ShellContent
        Title="Model Manager"
        ContentTemplate="{DataTemplate views:MlcModelSelectorPage}"
        Route="MlcModelSelectorPage"
        x:Name="MlcModelSelectorShellContent" />
    -->

    <!-- GGUF Model Manager - LLamaSharp (Gemma 3, Qwen3, Phi-3) -->
    <ShellContent
        Title="GGUF Models"
        ContentTemplate="{DataTemplate views:GgufModelManagerPage}"
        Route="GgufModelManagerPage" />

</Shell>
